# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,nginx

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_triage
POSTGRES_USER=triage_user
POSTGRES_PASSWORD=change-me-in-production

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# CORS
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000

# Whisper / ASR - CPU optimized
WHISPER_MODEL_SIZE=large-v3-turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# OpenAI (optional, for enhanced triage analysis)
OPENAI_API_KEY=your-openai-api-key

# Gemini (Google) AI - Required for triage analysis
GEMINI_API_KEY=your-gemini-api-key-here

# FHIR Server (optional)
FHIR_SERVER_URL=https://fhir.example.com/r4
FHIR_AUTH_TOKEN=your-fhir-auth-token

# Audio storage
AUDIO_UPLOAD_MAX_SIZE_MB=50