# ==============================================================================
# AI-TRIAGE - PLANTILLA DE CONFIGURACION DE ENTORNO (.env.example)
# ==============================================================================
# Copie este archivo como '.env' en la raiz del proyecto:
#   cp .env.example .env
# Complete los valores correspondientes para su entorno de desarrollo o produccion.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NUCLEO Y SEGURIDAD (DJANGO & APLICACION)
# ------------------------------------------------------------------------------
# Llave secreta criptografica de Django. Obligatoria en produccion (minimo 50 caracteres).
# Para generar una nueva: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-ai-triage-local-dev-secret-key-3289139-change-in-production

# Clave dedicada para cifrar las API keys guardadas en BD (Fernet, 32 bytes base64).
# Si se deja vacia se deriva de SECRET_KEY, y rotar SECRET_KEY dejaria ilegibles las llaves.
# Para generar una nueva: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Sesion JWT: el access token dura JWT_ACCESS_MINUTES y el refresh va en cookie httpOnly.
# Con DEBUG=False las cookies (sesion, CSRF y refresh JWT) son 'Secure': solo viajan por HTTPS.
# Si se sirve por HTTP en una IP de red local, establecer SECURE_COOKIES=False.
JWT_ACCESS_MINUTES=15
# SECURE_COOKIES=False

# HTTPS (nginx): sin certificado montado se genera uno autofirmado para TLS_SERVER_NAME.
# HSTS_MAX_AGE=0 en desarrollo; 31536000 en produccion con un certificado valido.
TLS_SERVER_NAME=localhost
HSTS_MAX_AGE=0
# Origenes HTTPS adicionales para formularios de Django Admin (p. ej. https://triage.hospital.local)
CSRF_TRUSTED_ORIGINS=https://localhost

# Modo depuracion: 'True' para desarrollo local, 'False' para produccion.
DEBUG=True

# Hosts autorizados (separados por coma, sin espacios adicionales)
ALLOWED_HOSTS=localhost,127.0.0.1

# URL base del cliente frontend para CORS y redirecciones
APP_URL=https://localhost

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS (POSTGRESQL)
# ------------------------------------------------------------------------------
# Configuracion de conexion a la base de datos relacional.
# En Docker Compose interno, DB_HOST suele ser 'db'.
DB_NAME=ai_triage_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------------------------------------------
# 3. CORREO ELECTRONICO Y NOTIFICACIONES OTP (SMTP / MAILPIT)
# ------------------------------------------------------------------------------
# En desarrollo local con Mailpit / Docker, EMAIL_HOST suele ser 'localhost' o 'mailpit'
# y el puerto SMTP estandar es 1025 (Web UI en http://localhost:8025).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AI-Triage <no-reply@hospital.com>

# ------------------------------------------------------------------------------
# 4. USUARIOS DEMO Y MIGRACIONES (OPT-IN)
# ------------------------------------------------------------------------------
# 'True' para aprovisionar usuarios demo (Admin y Enfermero) en entornos de desarrollo.
# 'False' por defecto para evitar creacion de cuentas demo en produccion.
CREATE_DEMO_USERS=False

# Credenciales de usuario administrador (Dr. Carlos Rodriguez)
DEMO_ADMIN_EMAIL=admin@hospital.com
DEMO_ADMIN_PASSWORD=

# Credenciales de usuario enfermeria (Enf. Laura Martinez)
DEMO_NURSE_EMAIL=enfermeria@hospital.com
DEMO_NURSE_PASSWORD=

# 'True' para forzar actualizacion de contrasenas de usuarios demo existentes
RESET_DEMO_PASSWORDS=False

# ------------------------------------------------------------------------------
# 5. LLAVES API DE MODELOS DE INTELIGENCIA ARTIFICIAL (BOVEDA DE CREDENCIALES)
# ------------------------------------------------------------------------------
# NOTA IMPORTANTE:
# Cualquier llave definida a continuacion sera detectada y sincronizada automaticamente
# hacia la Boveda de Credenciales Cifradas del sistema (Panel de Configuracion).
# En la interfaz web podra visualizar el proveedor, su estado activo y la mascara de la llave.

# Proveedor principal: Google Gemini (Recomendado para analisis de triaje y normalizacion clinica)
# Formato habitual: Inicia con 'AIzaSy...' o 'AQ....'
GEMINI_API_KEY=

# Proveedor opcional: OpenAI (GPT-4o, GPT-4o-mini)
# Formato habitual: Inicia con 'sk-proj-...' o 'sk-...'
OPENAI_API_KEY=

# Proveedor opcional: Anthropic (Claude 3.5 Sonnet)
# Formato habitual: Inicia con 'sk-ant-...'
ANTHROPIC_API_KEY=

# Proveedor opcional: DeepSeek
DEEPSEEK_API_KEY=

# Proveedores personalizados adicionales:
# Cualquier variable de entorno con sufijo '_API_KEY' (ej. GROQ_API_KEY, MISTRAL_API_KEY)
# sera detectada de forma automatica y visible en la seccion de credenciales del proyecto.
# GROQ_API_KEY=
# MISTRAL_API_KEY=

# ------------------------------------------------------------------------------
# 6. CONFIGURACION DEL CLIENTE FRONTEND (NEXT.JS)
# ------------------------------------------------------------------------------
# URL del backend para peticiones API desde el navegador
NEXT_PUBLIC_API_URL=http://localhost:8000
